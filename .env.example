# Goal Agent — Environment Variables
# Copy to .env and fill in your keys. NEVER commit .env to source control.

# ─── Model Providers ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-...
# Optional: Ollama runs locally at http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# ─── Model Role Assignments ──────────────────────────────────────────────────
PLANNER_MODEL=anthropic/claude-sonnet-4-5
EXECUTOR_MODEL=openai/gpt-4o
REVIEWER_MODEL=google/gemini-pro
SUMMARIZER_MODEL=ollama/qwen2.5

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite for local dev; replace with postgresql+asyncpg://... for production
DATABASE_URL=sqlite+aiosqlite:///./goal_agent.db

# ─── Service ─────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Add trusted frontend origins here if the UI is hosted elsewhere.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ─── Security ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed workspace root paths
ALLOWED_WORKSPACE_ROOTS=/workspaces,/home,C:\Users
SANDBOX_TIMEOUT_SECONDS=60
# Set true in deployments with Docker to run commands in a network-isolated container.
USE_DOCKER_SANDBOX=false
DOCKER_SANDBOX_IMAGE=goal-agent-sandbox:latest

# ─── Default Budgets ─────────────────────────────────────────────────────────
DEFAULT_MAX_ITERATIONS=40
DEFAULT_MAX_MINUTES=120
DEFAULT_MAX_COST_USD=25.0
